  "info": {
    "title": "Frontrow API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/events": {
      "get": {
        "operationId": "list_events_events_get",
        "parameters": [
          {
            "description": "today · tomorrow · weekend · YYYY-MM-DD (IST days)",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^(today|tomorrow|weekend|\\d{4}-\\d{2}-\\d{2})$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "today · tomorrow · weekend · YYYY-MM-DD (IST days)",
              "title": "Date"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "movie",
                    "concert"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          },
          {
            "in": "query",
            "name": "genre",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Genre"
            }
          },
          {
            "in": "query",
            "name": "venue",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Venue"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "soonest",
              "enum": [
                "soonest",
                "price",
                "title"
              ],
              "title": "Sort",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventList"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Error envelope (06 §C)"
          }
        },
        "summary": "List Events",
        "tags": [
          "catalog"
        ]
      }
    },
    "/events/{slug}": {
      "get": {
        "operationId": "get_event_events__slug__get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
