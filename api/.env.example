# Frontrow API — every key from docs/04-technical-design.md §13. Copy to .env.local for dev.
# Keys arrive just-in-time per plan row; leave the rest empty until that row.

# S2 — Neon Postgres (asyncpg URL). Vercel: production → Neon `production` branch, preview/dev → `dev`.
DATABASE_URL=postgresql+asyncpg://frontrow@localhost:5498/frontrow_dev
# Local/CI only: a throwaway database the pytest harness rebuilds via Alembic on every run.
TEST_DATABASE_URL=postgresql+asyncpg://frontrow@localhost:5498/frontrow_test

# F2 — Upstash Redis (TCP URL, rediss://…)
REDIS_URL=

# F4 / F6 — own session cookies + ticket QR tokens (openssl rand -hex 32)
SESSION_SECRET=
TICKET_SECRET=

# F5 — Razorpay test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Where the web app lives (absolute poster URLs, redirects)
WEB_URL=http://localhost:3000
