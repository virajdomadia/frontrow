# Frontrow API — every key from docs/04-technical-design.md §13. Copy to .env.local for dev.
# Keys arrive just-in-time per plan row; leave the rest empty until that row.

# S2 — Neon Postgres (asyncpg URL). Vercel: production → Neon `production` branch, preview/dev → `dev`.
DATABASE_URL=postgresql+asyncpg://frontrow@localhost:5498/frontrow_dev
# Local/CI only: a throwaway database the pytest harness rebuilds via Alembic on every run.
TEST_DATABASE_URL=postgresql+asyncpg://frontrow@localhost:5498/frontrow_test

# B2/B5 — Upstash Redis (TCP URL, rediss://default:<password>@<host>:6379). Local: any Redis.
REDIS_URL=redis://localhost:6379/0
# Local/CI only: a throwaway Redis database the tests flush before every test.
TEST_REDIS_URL=redis://localhost:6379/15

# B2 — Gmail SMTP for sign-in codes and ticket emails (a dedicated Gmail + an app password).
# Leave empty locally: codes are printed in the api log. On a deployment without them, sign-in by
# code answers 503 and the site points people at the demo buttons.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Frontrow <you@gmail.com>

# Seed only: real staff accounts (comma-separated) for the hidden /staff door
STAFF_EMAILS=

# B2 / B7 — own session cookies + ticket QR tokens (openssl rand -hex 32)
SESSION_SECRET=
TICKET_SECRET=
# The web tier forwards the visitor's address to the api with this (same value on both projects;
# openssl rand -hex 32). On a deployment the api refuses to start without all three.
PROXY_SECRET=

# B6 — Razorpay test mode. Leave the key pair empty to run the built-in demo gateway (checkout
# shows a labelled test payment). Webhook URL: https://<web domain>/api/webhooks/razorpay,
# events payment.captured + payment.failed, secret = RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Where the web app lives (absolute poster URLs, redirects)
WEB_URL=http://localhost:3000
